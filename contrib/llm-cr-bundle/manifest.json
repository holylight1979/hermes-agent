{
  "name": "llm-cr-bundle",
  "version": "1.0.0",
  "manifest_version": 1,
  "base_commit": "45a6101f36576367359c171cd5820ee76a3d047b",
  "base_commit_note": "core.patch is generated against this upstream commit and is checked with `git apply --check` (and `--reverse --check` for the already-applied case) before anything is written.",
  "ships_no_defaults": [
    "provider",
    "model",
    "return_provider",
    "return_model",
    "base_url",
    "instruction file content"
  ],
